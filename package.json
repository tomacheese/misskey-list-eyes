    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.9.10",
    "puppeteer-core": "25.14.0",
    "run-z": "2.1.0",
    "tsx": "4.23.15",
