    "eslint-plugin-n": "18.2.2",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.9.6",
    "puppeteer-core": "25.4.0",
    "run-z": "2.1.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
