    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.4.0",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.9.9",
    "puppeteer-core": "25.12.0",
    "run-z": "2.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
