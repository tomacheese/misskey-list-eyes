    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.9.9",
    "puppeteer-core": "25.12.0",
    "run-z": "2.1.0",
    "tsx": "4.23.15",
